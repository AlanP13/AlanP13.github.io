{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/graphify\" ] && \"$HOME/.local/bin/graphify\" hook-guard search || exit 0"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/graphify\" ] && \"$HOME/.local/bin/graphify\" hook-guard read || exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  }
}
