{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "read_file|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/graphify\" ] && \"$HOME/.local/bin/graphify\" hook-guard gemini || exit 0"
          }
        ]
      }
    ]
  }
}
