---
interface Props {
  images: string[];
  altPrefix?: string;
}
const { images, altPrefix = "Alan photo" } = Astro.props;
---

<div class="carousel" aria-label="Profile photo carousel" role="region">
  <div class="stack">
    {images.map((src, i) => (
      <div class="card" data-pos={i}>
        <img
          src={src}
          alt={`${altPrefix} ${i + 1}`}
          loading={i === 0 ? "eager" : "lazy"}
          width="320"
          height="400"
        />
      </div>
    ))}
  </div>
</div>

<script>
  const carousel = document.querySelector<HTMLElement>(".carousel");
  if (carousel) {
    const cards = Array.from(carousel.querySelectorAll<HTMLElement>(".card"));
    const total = cards.length;
    let front = 0;

    function sync() {
      cards.forEach((card, i) => {
        card.dataset.pos = String((i - front + total) % total);
      });
    }

    function advance() {
      front = (front + 1) % total;
      sync();
    }

    let timer = setInterval(advance, 1600);
    carousel.addEventListener("mouseenter", () => clearInterval(timer));
    carousel.addEventListener("mouseleave", () => { timer = setInterval(advance, 1600); });
    carousel.addEventListener("click", advance);
  }
</script>

<style>
  .carousel {
    width: 100%;
    max-width: 320px;
    padding-left: 18px;
    cursor: pointer;
  }

  .stack {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
  }

  .card {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.35);
    transition:
      transform 550ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
      opacity 550ms ease;
    will-change: transform, opacity;
  }

  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .card[data-pos="0"] {
    transform: rotate(0deg) translateY(0px) scale(1);
    opacity: 1;
    z-index: 4;
  }
  .card[data-pos="1"] {
    transform: rotate(-3deg) translateY(10px) scale(0.96);
    opacity: 0.68;
    z-index: 3;
  }
  .card[data-pos="2"] {
    transform: rotate(2.5deg) translateY(20px) scale(0.92);
    opacity: 0.42;
    z-index: 2;
  }
  .card[data-pos="3"] {
    transform: rotate(-1.5deg) translateY(28px) scale(0.88);
    opacity: 0.18;
    z-index: 1;
  }
</style>
