---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { FileText, LinkedinLogo, GithubLogo, Envelope } from "@phosphor-icons/react";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

/** Load organization logos from /src/assets/organizations */
const orgLogoModules = import.meta.glob<{ default: ImageMetadata }>("../assets/organizations/*.png", {
  eager: true,
});

/** Build a map like: { IIT: "/_astro/IIT.hash.webp", Genworth: "/_astro/Genworth.hash.webp" } */
const orgLogos = Object.fromEntries(
  await Promise.all(
    Object.entries(orgLogoModules).map(async ([path, mod]) => {
      const key = path.split("/").pop()?.replace(".png", "") ?? "";
      const opt = await getImage({ src: mod.default, width: 76, format: "webp" });
      return [key, opt.src] as [string, string];
    })
  )
);

const byOrderDescThenTitle = (
  a: CollectionEntry<"projects">,
  b: CollectionEntry<"projects">,
) => {
  const ao = a.data.order ?? 0;
  const bo = b.data.order ?? 0;
  if (bo !== ao) return bo - ao;
  return (a.data.title ?? "").localeCompare(b.data.title ?? "");
};

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .slice(0, 3)
  .sort(byOrderDescThenTitle);

const timeline = await getCollection("timeline");
const workItems = timeline
  .filter((t) => t.data.kind === "work")
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const eduItems = timeline
  .filter((t) => t.data.kind === "education")
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

/** Helper: returns the image URL (or null if not found) */
const getOrgLogo = (iconText: string) => orgLogos[iconText] ?? null;

const certItems = await getCollection("certifications");
const allCertsSorted = [...certItems].filter((c) => c.data.featured).sort((a, b) => {
  const priority: Record<string, number> = { "in-progress": 0, "planned": 1, "earned": 2, "expired": 3 };
  const sa = priority[a.data.status] ?? 99;
  const sb = priority[b.data.status] ?? 99;
  if (sa !== sb) return sa - sb;
  return (b.data.order ?? 0) - (a.data.order ?? 0);
});
const certsSorted = allCertsSorted.slice(0, 2);
const certsTotal = allCertsSorted.length;

const researchItems = await getCollection("research");
const allPublishedPapers = [...researchItems]
  .filter((r) => (r.data.publication_status ?? r.data.status) === "published")
  .sort((a, b) => {
    const da = a.data.publication_date ?? "";
    const db = b.data.publication_date ?? "";
    if (da !== db) return db.localeCompare(da);
    return (b.data.order ?? 0) - (a.data.order ?? 0);
  });
const publishedCount = allPublishedPapers.length;
const completedResearch = researchItems.filter(
  (r) => (r.data.publication_status ?? r.data.status) === "completed"
).length;
const featuredPapers = allPublishedPapers.filter((r) => r.data.featured).slice(0, 3);

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alan Palayil",
  jobTitle: "Application Development Analyst",
  worksFor: {
    "@type": "Organization",
    name: "Genworth Financial",
  },
  alumniOf: [
    {
      "@type": "EducationalOrganization",
      name: "Illinois Institute of Technology",
    },
    {
      "@type": "EducationalOrganization",
      name: "University of the Cumberlands",
    },
  ],
  url: "https://alanp13.github.io",
  sameAs: [
    "https://www.linkedin.com/in/alan-palayil/",
    "https://github.com/AlanP13",
    "https://orcid.org/0009-0004-8302-5090",
  ],
  workExample: allPublishedPapers.map((p) => ({
    "@type": "ScholarlyArticle",
    name: p.data.title,
    url: `https://alanp13.github.io/research/${p.slug}`,
    ...(p.data.doi ? { identifier: `https://doi.org/${p.data.doi}` } : {}),
  })),
});
---

<SiteLayout
  title="Alan Palayil"
  description="Application Development Analyst at Genworth Financial, building investment accounting data pipelines. PhD researcher in AI Governance and Data Science."
  schemaJson={personSchema}
>
  <section class="hero">
    <p class="kicker">
      Enterprise Data Platforms • Financial Systems • AI Governance
    </p>

    <h1>
      Hello! I’m <strong>Alan Palayil</strong><span class="wave">👋</span>
    </h1>

    <p class="lead">
      <span class="hl">Application Development Analyst</span> at <span class="hl">Genworth Financial</span>,
      engineering investment accounting data pipelines where correctness and reliability aren’t optional.
      PhD researcher in <span class="hl">AI Governance</span> and Data Science.
    </p>

    <div class="socialRow" aria-label="Social links">
      <a class="social" href="/resume">
        <span class="icon" aria-hidden="true">
          <FileText size={18} />
        </span>
        Resume
      </a>
      <span class="sep" aria-hidden="true">|</span>

      <a class="social" href="https://www.linkedin.com/in/alan-palayil/" target="_blank" rel="noreferrer">
        <span class="icon" aria-hidden="true">
          <LinkedinLogo size={18} />
        </span>
        LinkedIn
      </a>
      <span class="sep" aria-hidden="true">|</span>

      <a class="social" href="https://github.com/AlanP13" target="_blank" rel="noreferrer">
        <span class="icon" aria-hidden="true">
          <GithubLogo size={18} />
        </span>
        GitHub
      </a>
      <span class="sep" aria-hidden="true">|</span>

      <a class="social" href="/about">
        More about me <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* WORK & EDUCATION PANEL */}
  <section class="block">
    <div class="weTabs" role="tablist" aria-label="Work and education tabs">
      <button
        class="weTab isActive"
        role="tab"
        aria-selected="true"
        aria-controls="we-work"
        id="tab-work"
        type="button"
      >
        Work
      </button>
      <button
        class="weTab"
        role="tab"
        aria-selected="false"
        aria-controls="we-edu"
        id="tab-edu"
        type="button"
      >
        Education
      </button>
    </div>

    <div class="wePanelWrap">
      {/* WORK PANEL */}
      <div
        class="wePanel isActive"
        role="tabpanel"
        id="we-work"
        aria-labelledby="tab-work"
      >
        <div class="weCard">
          {
            workItems.map((item, idx) => (
              <>
                <article class="weRow">
                  <div class="weLeft">
                    <div class="weLogoWrap" aria-hidden="true">
                      {getOrgLogo(item.data.iconText) ? (
                        <img
                          class="weLogoImg"
                          src={getOrgLogo(item.data.iconText)}
                          alt={`${item.data.iconText} logo`}
                          loading="lazy"
                          width="38"
                          height="38"
                        />
                      ) : (
                        <div class="weLogoFallback">{item.data.iconText}</div>
                      )}
                    </div>
                  </div>

                  <div class="weMain">
                    <div class="weTop">
                      <div class="weTitles">
                        <h3 class="weTitle">{item.data.title}</h3>
                        <p class="weOrg">
                          {item.data.orgUrl ? (
                            <a
                              href={item.data.orgUrl}
                              target="_blank"
                              rel="noreferrer"
                              class="weOrgLink"
                            >
                              <span class="weOrgName">{item.data.org}</span>
                            </a>
                          ) : (
                            <span class="weOrgName">{item.data.org}</span>
                          )}
                          {item.data.location ? ` • ${item.data.location}` : ""}
                        </p>
                      </div>

                      <div class="weRight">
                        <div class="weDates">{item.data.dates}</div>

                        {item.data.bullets?.length ? (
                          <button
                            class="weChevron"
                            type="button"
                            aria-expanded="false"
                            aria-label={`Expand details for ${item.data.title}`}
                            data-we-toggle
                          >
                            <svg
                              viewBox="0 0 24 24"
                              width="18"
                              height="18"
                              aria-hidden="true"
                            >
                              <path
                                fill="currentColor"
                                d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"
                              />
                            </svg>
                          </button>
                        ) : null}
                      </div>
                    </div>

                    {/* SUMMARY (always visible) */}
                    {item.data.subtitle ? (
                      <p class="weSummary">{item.data.subtitle}</p>
                    ) : item.data.bullets?.length ? (
                      <p class="weSummary">{item.data.bullets[0]}</p>
                    ) : null}

                    {/* COLLAPSIBLE BULLETS */}
                    {item.data.bullets?.length ? (
                      <div class="weDetails" data-we-details>
                        <ul class="weBullets">
                          {item.data.bullets.map((b) => (
                            <li>{b}</li>
                          ))}
                        </ul>
                      </div>
                    ) : null}
                  </div>
                </article>

                {idx !== workItems.length - 1 ? (
                  <div class="weDivider" />
                ) : null}
              </>
            ))
          }
        </div>
      </div>

      {/* EDUCATION PANEL */}
      <div
        class="wePanel"
        role="tabpanel"
        id="we-edu"
        aria-labelledby="tab-edu"
      >
        <div class="weCard">
          {
            eduItems.map((item, idx) => (
              <>
                <article class="weRow">
                  <div class="weLeft">
                    <div class="weLogoWrap" aria-hidden="true">
                      {getOrgLogo(item.data.iconText) ? (
                        <img
                          class="weLogoImg"
                          src={getOrgLogo(item.data.iconText)}
                          alt={`${item.data.iconText} logo`}
                          loading="lazy"
                          width="38"
                          height="38"
                        />
                      ) : (
                        <div class="weLogoFallback">{item.data.iconText}</div>
                      )}
                    </div>
                  </div>

                  <div class="weMain">
                    <div class="weTop">
                      <div class="weTitles">
                        <h3 class="weTitle">{item.data.title}</h3>
                        <p class="weOrg">
                          {item.data.orgUrl ? (
                            <a
                              href={item.data.orgUrl}
                              target="_blank"
                              rel="noreferrer"
                              class="weOrgLink"
                            >
                              <span class="weOrgName">{item.data.org}</span>
                            </a>
                          ) : (
                            <span class="weOrgName">{item.data.org}</span>
                          )}
                          {item.data.location ? ` • ${item.data.location}` : ""}
                        </p>
                      </div>

                      <div class="weRight">
                        <div class="weDates">{item.data.dates}</div>

                        {item.data.bullets?.length ? (
                          <button
                            class="weChevron"
                            type="button"
                            aria-expanded="false"
                            aria-label={`Expand details for ${item.data.title}`}
                            data-we-toggle
                          >
                            <svg
                              viewBox="0 0 24 24"
                              width="18"
                              height="18"
                              aria-hidden="true"
                            >
                              <path
                                fill="currentColor"
                                d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"
                              />
                            </svg>
                          </button>
                        ) : null}
                      </div>
                    </div>

                    {/* SUMMARY (always visible) */}
                    {item.data.subtitle ? (
                      <p class="weSummary">{item.data.subtitle}</p>
                    ) : item.data.bullets?.length ? (
                      <p class="weSummary">{item.data.bullets[0]}</p>
                    ) : null}

                    {/* COLLAPSIBLE BULLETS */}
                    {item.data.bullets?.length ? (
                      <div class="weDetails" data-we-details>
                        <ul class="weBullets">
                          {item.data.bullets.map((b) => (
                            <li>{b}</li>
                          ))}
                        </ul>
                      </div>
                    ) : null}
                  </div>
                </article>

                {idx !== eduItems.length - 1 ? <div class="weDivider" /> : null}
              </>
            ))
          }
        </div>
      </div>
    </div>

    <script is:inline>
      const tabs = Array.from(document.querySelectorAll(".weTab"));
      const panels = Array.from(document.querySelectorAll(".wePanel"));

      function activate(index) {
        tabs.forEach((t, i) => {
          const on = i === index;
          t.classList.toggle("isActive", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        panels.forEach((p, i) => p.classList.toggle("isActive", i === index));
      }

      tabs.forEach((t, i) => t.addEventListener("click", () => activate(i)));

      // Work/Edu expand/collapse
      const rows = Array.from(document.querySelectorAll(".weRow"));

      function closeRow(row) {
        row.classList.remove("isOpen");
        const btn = row.querySelector("[data-we-toggle]");
        if (btn) btn.setAttribute("aria-expanded", "false");
      }

      function toggleRow(row) {
        const isOpen = row.classList.toggle("isOpen");
        const btn = row.querySelector("[data-we-toggle]");
        if (btn) btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }

      rows.forEach((row) => {
        const btn = row.querySelector("[data-we-toggle]");
        if (!btn) return;

        btn.addEventListener("click", (e) => {
          e.stopPropagation();

          // only one open at a time
          rows.forEach((r) => r !== row && closeRow(r));

          toggleRow(row);
        });

        // Collapse if you click elsewhere
        document.addEventListener("click", (e) => {
          if (!row.contains(e.target)) closeRow(row);
        });

        // Keyboard: Escape closes
        row.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeRow(row);
        });
      });
    </script>
  </section>

  <section class="block">
    <h2>Featured Projects</h2>

    <div class="grid">
      {
        projects.map((p) => (
          <a class="card" href={`/projects/${p.slug}`}>
            <div>
              <h3>{p.data.title}</h3>
              <p class="muted">{p.data.summary}</p>
            </div>

            <div class="metaRow">
              <span class="pill">Project Details →</span>
              <span class="tech">{p.data.tech.slice(0, 5).join(" · ")}</span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="allProjects">
      <a href="/projects">View all projects →</a>
    </p>
  </section>

  <section class="block">
    <h2>Research</h2>
    <p class="muted">
      Doctoral research at University of the Cumberlands, applied to enterprise and financial systems contexts.
    </p>
    <div class="rfChips">
      <span class="rfChip">AI Governance</span>
      <span class="rfChip">Enterprise Risk Management</span>
      <span class="rfChip">Financial Systems Modernization</span>
    </div>

    <div class="grid researchGrid">
      {
        featuredPapers.map((paper) => (
          <a class="card" href={`/research/${paper.slug}`}>
            <div>
              <h3>{paper.data.title}</h3>
              <p class="muted">{paper.data.summary}</p>
            </div>
            <div class="metaRow">
              <span class="pill">Read paper →</span>
              <span class="tech">{(paper.data.area ?? []).slice(0, 3).join(" · ")}</span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="rfLink">
      {publishedCount} published{completedResearch > 0 ? ` · ${completedResearch} completed` : ""}. <a href="/research">View all research →</a>
      <span class="rfOrcidInline"> · ORCID: <a href="https://orcid.org/0009-0004-8302-5090" target="_blank" rel="noreferrer">0009-0004-8302-5090 →</a></span>
    </p>
  </section>

  <section class="block">
    <h2>Technical Skills</h2>
    <div class="skillsGrid">
      <div class="skillCat">
        <h3>Enterprise Platforms</h3>
        <div class="chips">
          <span class="chip">PAM Investment Accounting</span>
          <span class="chip">Financial Systems Modernization</span>
          <span class="chip">Platform Migration</span>
          <span class="chip">Production Support</span>
        </div>
      </div>
      <div class="skillCat">
        <h3>Data Engineering</h3>
        <div class="chips">
          <span class="chip">Azure Synapse</span>
          <span class="chip">ETL Pipelines</span>
          <span class="chip">AppWorx</span>
          <span class="chip">Markit EDM</span>
          <span class="chip">Data Warehousing</span>
          <span class="chip">Data Reconciliation</span>
        </div>
      </div>
      <div class="skillCat">
        <h3>Cloud</h3>
        <div class="chips">
          <span class="chip">Microsoft Azure</span>
          <span class="chip">ADLS</span>
          <span class="chip">Serverless SQL</span>
          <span class="chip">Azure Monitoring</span>
          <span class="chip">Logic Apps</span>
          <span class="chip">Key Vault</span>
        </div>
      </div>
      <div class="skillCat">
        <h3>AI &amp; Data Science</h3>
        <div class="chips">
          <span class="chip">Machine Learning</span>
          <span class="chip">Time Series Forecasting</span>
          <span class="chip">AI Governance</span>
          <span class="chip">Data Mining</span>
          <span class="chip">Predictive Analytics</span>
        </div>
      </div>
      <div class="skillCat">
        <h3>Risk &amp; Governance</h3>
        <div class="chips">
          <span class="chip">Enterprise Risk Management</span>
          <span class="chip">Model Risk Management</span>
          <span class="chip">NIST</span>
          <span class="chip">COSO ERM</span>
          <span class="chip">Regulatory Compliance</span>
        </div>
      </div>
      <div class="skillCat">
        <h3>Languages</h3>
        <div class="chips">
          <span class="chip">Python</span>
          <span class="chip">SQL</span>
          <span class="chip">C++</span>
          <span class="chip">Java</span>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <h2>Credentials &amp; Memberships</h2>

    <div class="credGrid">
      <div class="credCard">
        <p class="credLabel">Academic Identity</p>
        <div class="credEntry">
          <div>
            <p class="credOrg">ORCID</p>
            <p class="credDesc">Open Researcher and Contributor ID</p>
          </div>
          <div class="credMeta">
            <a
              class="credLink"
              href="https://orcid.org/0009-0004-8302-5090"
              target="_blank"
              rel="noreferrer"
            >
              0009-0004-8302-5090 →
            </a>
          </div>
        </div>
        <div class="credDivider"></div>
        <div class="credEntry">
          <div>
            <p class="credOrg">PhD Candidate</p>
            <p class="credDesc">Information Technology · University of the Cumberlands</p>
          </div>
          <div class="credMeta">
            <span class="credDates">In Progress</span>
          </div>
        </div>
      </div>

      <div class="credCard">
        <p class="credLabel">Academic Honors</p>
        <div class="credEntry">
          <div>
            <p class="credOrg">Dean's List</p>
            <p class="credDesc">Armour College of Engineering · Illinois Institute of Technology</p>
          </div>
          <div class="credMeta">
            <span class="credDates">5 semesters</span>
          </div>
        </div>
      </div>

      <div class="credCard">
        <p class="credLabel">Professional Memberships</p>
        <div class="credEntry">
          <div>
            <p class="credOrg">IEEE Eta Kappa Nu (HKN)</p>
            <p class="credDesc">IEEE honor society - top academic standing</p>
          </div>
          <div class="credMeta">
            <span>Alumni Member</span>
            <span class="credDates">May 2023 - Present</span>
          </div>
        </div>
        <div class="credDivider"></div>
        <div class="credEntry">
          <div>
            <p class="credOrg">IEEE</p>
          </div>
          <div class="credMeta">
            <span>Member</span>
            <span class="credDates">May 2024 - Present</span>
          </div>
        </div>
        <div class="credDivider"></div>
        <div class="credEntry">
          <div>
            <p class="credOrg">SHPE</p>
          </div>
          <div class="credMeta">
            <span>Member</span>
            <span class="credDates">Aug 2022 - May 2023</span>
          </div>
        </div>
      </div>

      {certsSorted.length > 0 && (
        <div class="credCard">
          <p class="credLabel">Certifications</p>
          {certsSorted.map((cert) => (
            <div class="certEntry">
              <div class="certMain">
                <p class="certTitle">{cert.data.title}</p>
                <p class="certIssuer">{cert.data.issuer}</p>
                <div class="certTags">
                  <span class="certCat">{cert.data.category}</span>
                  {cert.data.skills.slice(0, 3).map((s) => (
                    <span class="certSkill">{s}</span>
                  ))}
                </div>
              </div>
              <div class="certMeta">
                {cert.data.status === "in-progress" && (
                  <span class="ipBadge">In Progress</span>
                )}
                {cert.data.status === "earned" && cert.data.credentialUrl && (
                  <a class="credLink" href={cert.data.credentialUrl} target="_blank" rel="noreferrer">Verify →</a>
                )}
                {cert.data.status === "earned" && !cert.data.credentialUrl && (
                  <span class="earnedBadge">Earned</span>
                )}
                {cert.data.dateObtained && (
                  <span class="credDates">{cert.data.dateObtained}</span>
                )}
              </div>
            </div>
          ))}
          {certsTotal > 2 && (
            <a class="certSeeAll" href="/resume#certifications">
              +{certsTotal - 2} more on resume →
            </a>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="contact">
    <div class="contactInner">
      <div class="contactText">
        <h2 class="contactHead">Let's connect</h2>
        <p class="contactSub">
          I build data infrastructure for financial systems and research AI governance at the doctoral level.
          If you're working on similar problems, I'd enjoy the conversation.
        </p>
      </div>
      <div class="contactActions">
        <div class="ctaBtns">
          <a
            class="ctaBtn ctaPrimary"
            href="https://www.linkedin.com/in/alan-palayil/"
            target="_blank"
            rel="noreferrer"
          >
            <span aria-hidden="true"><LinkedinLogo size={16} /></span>
            LinkedIn
          </a>
          <a class="ctaBtn ctaSecondary" href="mailto:alan.palayil+portfolio@gmail.com">
            <span aria-hidden="true"><Envelope size={16} /></span>
            Prefer Email?
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* HERO */
    .hero {
      padding-top: 44px;
      padding-bottom: 8px;

      
      max-width: var(--content, 1100px);
      margin-left: auto;
      margin-right: auto;
    }
    .kicker {
      color: rgb(var(--muted));
      margin: 0 0 12px;
      font-size: 16px;
      letter-spacing: 0.01em;
    }

    .hero h1 {
      margin: 0 0 12px;
      font-size: clamp(52px, 5vw, 68px); /* responsive, bigger */
      line-height: 1.02;
      letter-spacing: -0.03em;
    }

    .lead {
      font-size: 20px;
      line-height: 1.75;
      max-width: 72ch;
      margin: 0 0 12px;
    }

    @media (max-width: 620px) {
      .kicker {
        font-size: 14px;
      }
      .lead {
        font-size: 18px;
      }
    }
    .wave {
      display: inline-block;
      transform-origin: 70% 70%;
      cursor: default;
    }

    /* Trigger animation on hover */
    .wave:hover {
      animation: wave-hand 1.2s infinite ease-in-out;
      animation-delay: 0.1s;
    }

    /* Keyframes */
    @keyframes wave-hand {
      0% {
        transform: rotate(0deg);
      }
      15% {
        transform: rotate(14deg);
      }
      30% {
        transform: rotate(-8deg);
      }
      45% {
        transform: rotate(14deg);
      }
      60% {
        transform: rotate(-4deg);
      }
      75% {
        transform: rotate(10deg);
      }
      100% {
        transform: rotate(0deg);
      }
    }

