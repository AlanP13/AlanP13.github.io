---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const items = await getCollection("research");
const publishedCount = items.filter(
  (r) => (r.data.publication_status ?? r.data.status) === "published"
).length;

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  const [year, month, day] = dateStr.split("-").map(Number);
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${months[month - 1]} ${day}, ${year}`;
}

const statusRank: Record<string, number> = {
  published: 0,
  completed: 0,
  accepted: 1,
  "under-review": 2,
  submitted: 2,
  "in-progress": 3,
};

const statusLabels: Record<string, string> = {
  completed: "Completed",
  published: "Published",
  "in-progress": "In Progress",
  submitted: "Submitted",
  "under-review": "Under Review",
  accepted: "Accepted",
};

items.sort((a, b) => {
  const ea = a.data.publication_status ?? a.data.status;
  const eb = b.data.publication_status ?? b.data.status;
  const sa = statusRank[ea] ?? 99;
  const sb = statusRank[eb] ?? 99;
  if (sa !== sb) return sa - sb;
  const ao = a.data.order ?? 0;
  const bo = b.data.order ?? 0;
  if (bo !== ao) return bo - ao;
  return (a.data.title ?? "").localeCompare(b.data.title ?? "");
});

// Top 5 areas by frequency across the collection
const TOP_FILTERS = ["Security", "Systems Research", "Machine Learning", "Data Science", "Education"];
---

<SiteLayout
  title="Research — Alan Palayil"
  description="Applied research in AI Governance, enterprise data systems, and financial systems modernization. Technical reports from a PhD in Information Technology at University of the Cumberlands."
>
  <div class="hd">
    <h1>Research</h1>
    <p class="sub">
      {publishedCount} papers published via Engineering-to-Research Monograph Series, indexed on Zenodo and OpenAIRE.
    </p>
  </div>

  <div class="controls">
    <div class="chips" id="filter-chips" role="group" aria-label="Filter by topic">
      <button class="fchip active" data-filter="all">All</button>
      {TOP_FILTERS.map(area => (
        <button class="fchip" data-filter={area}>{area}</button>
      ))}
    </div>
    <div class="sorts" role="group" aria-label="Sort research">
      <button class="sbtn active" id="sort-status">Status</button>
      <button class="sbtn" id="sort-cycle">A–Z</button>
    </div>
  </div>

  <div class="stack" id="research-stack">
    {items.map((r, idx) => {
      const es = r.data.publication_status ?? r.data.status;
      const esLabel = statusLabels[es] ?? es;
      const areasStr = (r.data.area ?? []).join(",");
      const pubDate = r.data.publication_date ?? r.data.date ?? "";
      return (
        <a
          class="card"
          href={`/research/${r.slug}`}
          data-areas={areasStr}
          data-date={pubDate}
          data-title={r.data.title ?? ""}
          data-order={idx}
        >
          <div class="top">
            <h2>{r.data.title}</h2>
            <div class="top-right">
              {pubDate && (
                <time class="pub-date" datetime={pubDate}>{formatDate(pubDate)}</time>
              )}
              <span class={`badge ${es}`}>{esLabel}</span>
              {r.data.doi && <span class="badge doi-badge">Zenodo DOI</span>}
            </div>
          </div>
          <p class="muted">{r.data.summary}</p>
          {r.data.area?.length ? (
            <p class="meta">{r.data.area.slice(0, 4).join(" · ")}</p>
          ) : null}
          <p class="cta">Read more →</p>
        </a>
      );
    })}
    <p class="empty" id="empty-state" hidden>No papers match the selected topic.</p>
  </div>

  <script>
    (() => {
      const chipsWrap   = document.getElementById("filter-chips");
      const statusBtn   = document.getElementById("sort-status")  as HTMLButtonElement | null;
      const cycleBtn    = document.getElementById("sort-cycle")   as HTMLButtonElement | null;
      const stack       = document.getElementById("research-stack") as HTMLElement | null;
      const emptyState  = document.getElementById("empty-state")  as HTMLElement | null;

      const CYCLE = [
        { key: "az",     label: "A–Z"    },
        { key: "za",     label: "Z–A"    },
        { key: "newest", label: "Newest" },
        { key: "oldest", label: "Oldest" },
      ];
      let cycleIdx     = 0;
      let activeFilter = "all";
      let activeSort   = "default";

      function allCards(): HTMLElement[] {
        return Array.from(document.querySelectorAll<HTMLElement>(".card[data-areas]"));
      }

      function apply() {
        const cards = allCards();

        // Filter
        cards.forEach(card => {
          const areas = (card.dataset.areas ?? "").split(",").filter(Boolean);
          card.hidden = activeFilter !== "all" && !areas.includes(activeFilter);
        });

        // Sort visible cards
        const visible = cards.filter(c => !c.hidden);
        if (activeSort === "az") {
          visible.sort((a, b) => (a.dataset.title ?? "").localeCompare(b.dataset.title ?? ""));
        } else if (activeSort === "za") {
          visible.sort((a, b) => (b.dataset.title ?? "").localeCompare(a.dataset.title ?? ""));
        } else if (activeSort === "newest") {
          visible.sort((a, b) => (b.dataset.date ?? "").localeCompare(a.dataset.date ?? ""));
        } else if (activeSort === "oldest") {
          visible.sort((a, b) => (a.dataset.date ?? "").localeCompare(b.dataset.date ?? ""));
        } else {
          visible.sort((a, b) => Number(a.dataset.order ?? 0) - Number(b.dataset.order ?? 0));
        }
        visible.forEach(el => stack?.appendChild(el));

        if (emptyState) emptyState.hidden = visible.length > 0;
      }

      // Filter chips
      chipsWrap?.addEventListener("click", e => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".fchip");
        if (!btn) return;
        document.querySelectorAll(".fchip").forEach(c => c.classList.remove("active"));
        btn.classList.add("active");
        activeFilter = btn.dataset.filter ?? "all";
        apply();
      });

      // Status sort (default)
      statusBtn?.addEventListener("click", () => {
        statusBtn.classList.add("active");
        cycleBtn?.classList.remove("active");
        cycleIdx = 0;
        if (cycleBtn) cycleBtn.textContent = CYCLE[0].label;
        activeSort = "default";
        apply();
      });

      // Cycling sort — A–Z → Z–A → Newest → Oldest → A–Z…
      cycleBtn?.addEventListener("click", () => {
        if (cycleBtn.classList.contains("active")) {
          cycleIdx = (cycleIdx + 1) % CYCLE.length;
        } else {
          cycleIdx = 0;
          statusBtn?.classList.remove("active");
          cycleBtn.classList.add("active");
        }
        cycleBtn.textContent = CYCLE[cycleIdx].label;
        activeSort = CYCLE[cycleIdx].key;
        apply();
      });
    })();
  </script>

  <style>
    .hd {
      max-width: var(--content, 1100px);
      margin: 0 auto;
    }
    h1 {
      margin: 0 0 10px;
      font-size: 44px;
      letter-spacing: -0.03em;
      color: rgb(var(--accent));
      font-weight: 800;
    }
    .sub {
      color: rgb(var(--muted));
      margin: 0 0 4px;
      font-size: 15px;
    }

    /* ---- controls (matches projects page) ---- */
    .controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin: 20px auto 24px;
      max-width: var(--content, 1100px);
    }
    .chips {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }
    .fchip {
      padding: 5px 13px;
      border-radius: 999px;
      border: 1px solid rgb(var(--border));
      background: var(--card-bg);
      color: rgb(var(--muted));
      font-size: 12px;
      cursor: pointer;
      transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
      line-height: 1.5;
    }
    .fchip:hover,
    .fchip.active {
      border-color: rgb(var(--accent));
      color: rgb(var(--accent));
      background: rgb(var(--accent) / 0.08);
    }
    .sorts {
      display: flex;
      gap: 4px;
    }
    .sbtn {
      padding: 5px 11px;
      border-radius: var(--r);
      border: 1px solid transparent;
      background: transparent;
      color: rgb(var(--muted));
      font-size: 12px;
      cursor: pointer;
      transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
    }
    .sbtn.active {
      color: rgb(var(--text));
      border-color: rgb(var(--border));
      background: var(--card-bg);
    }
    .sbtn:hover:not(.active) {
      color: rgb(var(--text));
    }

    /* ---- cards ---- */
    .stack {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: var(--content, 1100px);
      margin: 0 auto;
    }
    .card {
      display: block;
      text-decoration: none;
      color: rgb(var(--text));
      border: 1px solid rgb(var(--border));
      border-radius: var(--r);
      padding: 16px 18px;
      background: var(--card-bg);
      transition: transform 120ms ease, border-color 120ms ease;
    }
    .card:hover {
      transform: translateY(-2px);
      border-color: rgb(var(--accent));
    }
    .top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    h2 {
      margin: 0;
      font-size: 16px;
      line-height: 1.35;
    }
    .top-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }
    .pub-date {
      font-size: 12px;
      color: rgb(var(--muted));
      white-space: nowrap;
    }
    .badge {
      font-size: 12px;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid rgb(var(--border));
      color: rgb(var(--muted));
      white-space: nowrap;
    }
    .badge.published,
    .badge.completed {
      border-color: rgb(var(--accent));
      color: rgb(var(--accent));
    }
    .badge.submitted {
      border-color: color-mix(in srgb, rgb(var(--accent)) 75%, rgb(var(--muted)));
      color: color-mix(in srgb, rgb(var(--accent)) 75%, rgb(var(--muted)));
    }
    .badge.doi-badge {
      border-color: color-mix(in srgb, rgb(var(--accent)) 38%, transparent);
      color: color-mix(in srgb, rgb(var(--accent)) 68%, rgb(var(--muted)));
      background: color-mix(in srgb, rgb(var(--accent)) 8%, transparent);
    }
    .badge.in-progress {
      border-color: color-mix(in srgb, rgb(var(--accent)) 50%, rgb(var(--muted)));
      color: color-mix(in srgb, rgb(var(--accent)) 50%, rgb(var(--muted)));
    }
    .muted {
      color: rgb(var(--muted));
      margin: 8px 0 0;
      font-size: 14px;
    }
    .meta {
      color: rgb(var(--muted));
      font-size: 12px;
      margin: 6px 0 0;
    }
    .cta {
      margin-top: 10px;
      font-size: 13px;
      color: rgb(var(--accent));
    }
    .empty {
      color: rgb(var(--muted));
      text-align: center;
      padding: 32px 0;
    }

    @media (max-width: 600px) {
      h1 { font-size: 32px; }
      .pub-date { display: none; }
      .top { flex-direction: column; gap: 8px; }
      .top-right { flex-wrap: wrap; }
    }
  </style>
</SiteLayout>
