---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const items = await getCollection("research");

const statusRank: Record<string, number> = {
  published: 0,
  completed: 0,
  accepted: 1,
  "under-review": 2,
  submitted: 2,
  "in-progress": 3,
};

const statusLabels: Record<string, string> = {
  completed: "Completed",
  published: "Published",
  "in-progress": "In Progress",
  submitted: "Submitted",
  "under-review": "Under Review",
  accepted: "Accepted",
};

const byOrderDescThenTitle = (a: any, b: any) => {
  const ao = a.data.order ?? 0;
  const bo = b.data.order ?? 0;
  if (bo !== ao) return bo - ao;
  return (a.data.title ?? "").localeCompare(b.data.title ?? "");
};

items.sort((a, b) => {
  const ea = a.data.publication_status ?? a.data.status;
  const eb = b.data.publication_status ?? b.data.status;
  const sa = statusRank[ea] ?? 99;
  const sb = statusRank[eb] ?? 99;
  if (sa !== sb) return sa - sb;
  return byOrderDescThenTitle(a, b);
});
---


<SiteLayout
  title="Research — Alan Palayil"
  description="Applied research in AI Governance, enterprise data systems, and financial systems modernization. Technical reports from a PhD in Information Technology at University of the Cumberlands."
>
  <h1>Research</h1>
  <p class="muted">
    Applied research work related to AI and Data Science in enterprise systems.
    Includes in-progress items.
  </p>

  <div class="stack">
    {
      items.map((r) => {
        const es = r.data.publication_status ?? r.data.status;
        const esLabel = statusLabels[es] ?? es;
        return (
          <a class="card" href={`/research/${r.slug}`}>
            <div class="top">
              <h2>{r.data.title}</h2>
              <span class={`badge ${es}`}>{esLabel}</span>
            </div>
            <p class="muted">{r.data.summary}</p>
            {r.data.relevance ? (
              <p class="rel">
                <strong>Relevance:</strong> {r.data.relevance}
              </p>
            ) : null}
            {r.data.area?.length ? (
              <p class="meta">{r.data.area.join(" · ")}</p>
            ) : null}
            <p class="cta">Read more →</p>
          </a>
        );
      })
    }
  </div>

  <style>
    h1 {
      margin: 0 0 18px;
      font-size: 44px;
      letter-spacing: -0.03em;
      color: rgb(var(--accent));
      font-weight: 800;
      /* ✅ match section width */
      max-width: var(--content, 1100px);
      margin-left: auto;
      margin-right: auto;
    }
    .muted {
      color: rgb(var(--muted));
      /* ✅ match section width */
      max-width: var(--content, 1100px);
      margin-left: auto;
      margin-right: auto;
    }
    .stack {
      margin-top: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      /* ✅ match section width */
      max-width: var(--content, 1100px);
      margin-left: auto;
      margin-right: auto;
    }
    .card {
      display: block;
      text-decoration: none;
      color: rgb(var(--text));
      border: 1px solid rgb(var(--border));
      border-radius: var(--r);
      padding: 14px;
      background: rgba(255, 255, 255, 0.02);
      transition:
        transform 120ms ease,
        border-color 120ms ease;
    }
    .card:hover {
      transform: translateY(-2px);
      border-color: rgb(var(--accent));
    }
    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    h2 {
      margin: 0;
      font-size: 16px;
    }
    .badge {
      font-size: 12px;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgb(var(--border));
      color: rgb(var(--muted));
    }
    .badge.published {
      border-color: color-mix(
        in srgb,
        rgb(var(--accent)) 100%,
        rgb(var(--muted))
      );
      color: color-mix(in srgb, rgb(var(--accent)) 100%, rgb(var(--muted)));
    }
    .badge.submitted {
      border-color: color-mix(
        in srgb,
        rgb(var(--accent)) 75%,
        rgb(var(--muted))
      );
      color: color-mix(in srgb, rgb(var(--accent)) 75%, rgb(var(--muted)));
    }
    .badge.completed,
    .badge.published {
      border-color: rgb(var(--accent));
      color: rgb(var(--accent));
    }
    .badge.in-progress {
      border-color: color-mix(
        in srgb,
        rgb(var(--accent)) 50%,
        rgb(var(--muted))
      );
      color: color-mix(in srgb, rgb(var(--accent)) 50%, rgb(var(--muted)));
      opacity: 0.9;
    }
    .rel {
      color: rgb(var(--muted));
      max-width: 80ch;
    }
    .meta {
      color: rgb(var(--muted));
      font-size: 12px;
    }
    .cta {
      margin-top: 10px;
      font-size: 13px;
      color: rgb(var(--accent));
    }
  </style>
</SiteLayout>
