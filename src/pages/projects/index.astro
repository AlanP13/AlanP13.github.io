---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

const byOrderDescThenTitle = (
  a: (typeof projects)[0],
  b: (typeof projects)[0],
) => {
  const ao = a.data.order ?? 0;
  const bo = b.data.order ?? 0;
  if (bo !== ao) return bo - ao;
  return (a.data.title ?? "").localeCompare(b.data.title ?? "");
};

const FILTERS = [
  { key: "enterprise", label: "Enterprise",      tags: ["finance","enterprise","financial-systems","derivatives","azure","reliability","platform-ops","operations"] },
  { key: "ai",         label: "AI / ML",          tags: ["edge-ai","ai-systems","ai-platforms","nlp","computer-vision","decision-support"] },
  { key: "systems",    label: "Systems",          tags: ["systems","distributed-systems","embedded","iot","cpu","assembly","simulator","simulation"] },
  { key: "data",       label: "Data & Pipelines", tags: ["data-platforms","pipelines","data-pipelines","metadata"] },
  { key: "automation", label: "Automation",       tags: ["automation","mqtt","platform-ops"] },
];

function getBuckets(tags: string[] | undefined): string {
  const t = tags ?? [];
  return FILTERS
    .filter(fg => t.some(tag => fg.tags.includes(tag)))
    .map(fg => fg.key)
    .join(" ");
}

const featured = projects.filter((p) => p.data.featured).sort(byOrderDescThenTitle);
const rest     = projects.filter((p) => !p.data.featured).sort(byOrderDescThenTitle);
---

<SiteLayout
  title="Projects — Alan Palayil"
  description="Engineering projects in financial data platforms, enterprise systems modernization, and applied AI. Industry work and personal builds by Alan Palayil."
>
  <div class="hd">
    <h1>Projects</h1>
    <p class="sub">Featured projects and other work over the years. See GitHub for more.</p>
  </div>

  <div class="controls">
    <div class="chips" id="filter-chips" role="group" aria-label="Filter by topic">
      <button class="fchip active" data-filter="all">All</button>
      {FILTERS.map(f => (
        <button class="fchip" data-filter={f.key}>{f.label}</button>
      ))}
    </div>
    <div class="sorts" role="group" aria-label="Sort projects">
      <button class="sbtn active" id="sort-featured">Featured</button>
      <button class="sbtn" id="sort-cycle">A–Z</button>
    </div>
  </div>

  {featured.length ? (
    <section class="section" id="sec-featured">
      <h2 class="section-title">Featured</h2>
      <div class="grid" id="grid-featured">
        {featured.map((p, idx) => (
          <a
            class="card"
            href={`/projects/${p.slug}`}
            data-buckets={getBuckets(p.data.tags)}
            data-title={p.data.title}
            data-order={idx}
          >
            <div>
              <h3>{p.data.title}</h3>
              <p class="muted">{p.data.summary}</p>
            </div>
            <div class="metaRow">
              <span class="pill">Details →</span>
              <span class="tech">{p.data.tech.slice(0, 4).join(" · ")}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  {rest.length ? (
    <section class="section" id="sec-rest">
      <h2 class="section-title">Other Projects</h2>
      <div class="list" id="list-rest">
        {rest.map((p, idx) => (
          <a
            class="row"
            href={`/projects/${p.slug}`}
            data-buckets={getBuckets(p.data.tags)}
            data-title={p.data.title}
            data-order={idx}
          >
            <div>
              <h3 class="rowTitle">{p.data.title}</h3>
              <p class="muted">{p.data.summary}</p>
              <p class="meta">{p.data.tech.slice(0, 4).join(" · ")}</p>
            </div>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  <script>
    (() => {
      const chipsWrap   = document.getElementById("filter-chips");
      const featuredBtn = document.getElementById("sort-featured") as HTMLButtonElement | null;
      const cycleBtn    = document.getElementById("sort-cycle")    as HTMLButtonElement | null;
      const sections    = Array.from(document.querySelectorAll<HTMLElement>(".section"));

      const CYCLE = [
        { key: "az", label: "A–Z" },
        { key: "za", label: "Z–A" },
      ];
      let cycleIdx     = 0;
      let activeFilter = "all";
      let activeSort   = "default";

      function cards(): HTMLElement[] {
        return Array.from(document.querySelectorAll<HTMLElement>("[data-buckets]"));
      }

      function apply() {
        // Filter
        cards().forEach(card => {
          const buckets = (card.dataset.buckets ?? "").split(" ").filter(Boolean);
          card.hidden = activeFilter !== "all" && !buckets.includes(activeFilter);
        });

        // Sort within each container
        const containers = new Set(cards().map(c => c.parentElement).filter(Boolean));
        containers.forEach(container => {
          if (!container) return;
          const visible = Array.from(
            container.querySelectorAll<HTMLElement>("[data-title]:not([hidden])")
          );
          if (activeSort === "az") {
            visible.sort((a, b) => (a.dataset.title ?? "").localeCompare(b.dataset.title ?? ""));
          } else if (activeSort === "za") {
            visible.sort((a, b) => (b.dataset.title ?? "").localeCompare(a.dataset.title ?? ""));
          } else {
            visible.sort((a, b) => Number(a.dataset.order ?? 0) - Number(b.dataset.order ?? 0));
          }
          visible.forEach(el => container.appendChild(el));
        });

        // Hide sections with no visible cards
        sections.forEach(sec => {
          sec.hidden = !Array.from(
            sec.querySelectorAll<HTMLElement>("[data-buckets]")
          ).some(c => !c.hidden);
        });
      }

      // Filter chips
      chipsWrap?.addEventListener("click", e => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".fchip");
        if (!btn) return;
        document.querySelectorAll(".fchip").forEach(c => c.classList.remove("active"));
        btn.classList.add("active");
        activeFilter = btn.dataset.filter ?? "all";
        apply();
      });

      // Featured sort — reset cycle to first state
      featuredBtn?.addEventListener("click", () => {
        featuredBtn.classList.add("active");
        cycleBtn?.classList.remove("active");
        cycleIdx = 0;
        if (cycleBtn) cycleBtn.textContent = CYCLE[0].label;
        activeSort = "default";
        apply();
      });

      // Cycling sort — advance through A–Z → Z–A → A–Z…
      cycleBtn?.addEventListener("click", () => {
        if (cycleBtn.classList.contains("active")) {
          cycleIdx = (cycleIdx + 1) % CYCLE.length;
        } else {
          cycleIdx = 0;
          featuredBtn?.classList.remove("active");
          cycleBtn.classList.add("active");
        }
        cycleBtn.textContent = CYCLE[cycleIdx].label;
        activeSort = CYCLE[cycleIdx].key;
        apply();
      });
    })();
  </script>

  <style>
    .hd {
      max-width: var(--content, 1100px);
      margin: 0 auto;
    }
    h1 {
      margin: 0 0 10px;
      font-size: 44px;
      letter-spacing: -0.03em;
      color: rgb(var(--accent));
      font-weight: 800;
    }
    .sub {
      color: rgb(var(--muted));
      margin: 0 0 4px;
      font-size: 15px;
    }

    /* ---- controls ---- */
    .controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin: 20px auto 24px;
      max-width: var(--content, 1100px);
    }
    .chips {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }
    .fchip {
      padding: 5px 13px;
      border-radius: 999px;
      border: 1px solid rgb(var(--border));
      background: var(--card-bg);
      color: rgb(var(--muted));
      font-size: 12px;
      cursor: pointer;
      transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
      line-height: 1.5;
    }
    .fchip:hover,
    .fchip.active {
      border-color: rgb(var(--accent));
      color: rgb(var(--accent));
      background: rgb(var(--accent) / 0.08);
    }
    .sorts {
      display: flex;
      gap: 4px;
    }
    .sbtn {
      padding: 5px 11px;
      border-radius: var(--r);
      border: 1px solid transparent;
      background: transparent;
      color: rgb(var(--muted));
      font-size: 12px;
      cursor: pointer;
      transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
    }
    .sbtn.active {
      color: rgb(var(--text));
      border-color: rgb(var(--border));
      background: var(--card-bg);
    }
    .sbtn:hover:not(.active) {
      color: rgb(var(--text));
    }

    /* ---- sections ---- */
    .section {
      margin: 0 auto 8px;
      max-width: var(--content, 1100px);
    }
    .section-title {
      margin: 0 0 12px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: color-mix(in srgb, rgb(var(--accent)) 65%, rgb(var(--muted)));
    }

    /* ---- featured grid ---- */
    .grid {
      display: grid;
      gap: 14px;
      grid-template-columns: 1fr;
    }
    @media (min-width: 860px) {
      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .grid .card:first-child {
        grid-column: 1 / -1;
        flex-direction: row;
        align-items: center;
        gap: 32px;
        min-height: 120px;
      }
      .grid .card:first-child > div:first-child {
        flex: 1;
      }
    }

    .card {
      text-decoration: none;
      border: 1px solid rgb(var(--border));
      border-radius: var(--r);
      padding: 18px 20px 16px;
      background: var(--card-bg);
      transition: transform 120ms ease, border-color 120ms ease;
      color: rgb(var(--text));
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 160px;
    }
    .card:hover {
      transform: translateY(-2px);
      border-color: rgb(var(--accent));
    }
    .card h3 {
      margin: 0 0 8px;
      font-size: 16px;
    }
    .metaRow {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
      margin-top: 12px;
    }
    .pill {
      color: rgb(var(--accent));
      font-size: 13px;
      flex-shrink: 0;
    }
    .tech {
      color: rgb(var(--muted));
      font-size: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 55%;
      text-align: right;
    }

    /* ---- other projects list ---- */
    .list {
      margin-top: 10px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      text-decoration: none;
      color: rgb(var(--text));
      border: 1px solid rgb(var(--border));
      border-radius: var(--r);
      padding: 14px;
      background: var(--card-bg);
      transition: border-color 120ms ease;
    }
    .row:hover {
      border-color: rgb(var(--accent));
    }
    .rowTitle {
      margin: 0 0 6px;
      font-size: 16px;
    }
    .muted {
      color: rgb(var(--muted));
      margin: 0;
      font-size: 14px;
    }
    .meta {
      margin: 8px 0 0;
      font-size: 12px;
      color: rgb(var(--muted));
    }
    .go {
      color: rgb(var(--accent));
      font-size: 18px;
      flex-shrink: 0;
      align-self: center;
    }
  </style>
</SiteLayout>
