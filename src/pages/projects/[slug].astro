---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p, all: projects },
  }));
}

const { project, all } = Astro.props;
const { Content } = await project.render();

const byOrderDescThenTitle = (a: any, b: any) => {
  const ao = a.data.order ?? 0;
  const bo = b.data.order ?? 0;
  if (bo !== ao) return bo - ao;
  return (a.data.title ?? "").localeCompare(b.data.title ?? "");
};

// Featured projects first, then timeline order.
const ordered = [...all].sort((a, b) => {
  const fa = a.data.featured ? 0 : 1;
  const fb = b.data.featured ? 0 : 1;
  if (fa !== fb) return fa - fb;
  return byOrderDescThenTitle(a, b);
});

// Circular previous and next navigation.
const idx = ordered.findIndex((p) => p.slug === project.slug);
const next = idx >= 0 ? ordered[(idx + 1) % ordered.length] : null;
const prev =
  idx >= 0 ? ordered[(idx - 1 + ordered.length) % ordered.length] : null;
---

<SiteLayout
  title={`${project.data.title} — Alan Palayil`}
  description={project.data.summary}
>
  <article class="page">
    <p class="back"><a href="/projects">← Back to Projects</a></p>

    <header class="head">
      <h1>{project.data.title}</h1>
      <p class="lead">{project.data.summary}</p>

      <div class="metaRow">
        {
          project.data.role ? (
            <span class="chip">Role: {project.data.role}</span>
          ) : null
        }
        {
          project.data.tags?.length ? (
            <span class="chip">
              Tags: {project.data.tags.slice(0, 4).join(" · ")}
            </span>
          ) : null
        }
        {
          project.data.featured ? (
            <span class="chip featured">Featured</span>
          ) : null
        }
      </div>
    </header>

    <div class="content">
      <div class="main prose">
        {
          project.data.highlights?.length ? (
            <>
              <h2>Highlights</h2>
              <ul>
                {project.data.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </>
          ) : null
        }
        {
          project.data.links?.length ? (
            <>
              <h2>Links</h2>
              <p>
                {project.data.links.map((l) => (
                  <a
                    href={l.url}
                    target="_blank"
                    style="margin-right: 12px; color: rgb(var(--accent)); text-decoration: none;"
                  >
                    {l.label} →
                  </a>
                ))}
              </p>
            </>
          ) : null
        }

        {
          project.data.impact?.length ? (
            <>
              <h2>Impact</h2>
              <ul>
                {project.data.impact.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </>
          ) : null
        }

        <hr />

        <Content />

        {
          prev || next ? (
            <nav class="projectNav" aria-label="Project navigation">
              {prev ? (
                <a
                  class="projectNavLink previous"
                  href={`/projects/${prev.slug}`}
                >
                  <span aria-hidden="true">←</span>
                  <span>
                    <span class="projectNavLabel">Previous project</span>
                    {prev.data.title}
                  </span>
                </a>
              ) : null}

              {next ? (
                <a
                  class="projectNavLink next"
                  href={`/projects/${next.slug}`}
                >
                  <span>
                    <span class="projectNavLabel">Next project</span>
                    {next.data.title}
                  </span>
                  <span aria-hidden="true">→</span>
                </a>
              ) : null}
            </nav>
          ) : null
        }
      </div>

      <aside class="aside">
        <div class="card">
          <h3>Key Info</h3>
          {
            project.data.tech?.length ? (
              <p class="kv">
                <strong>Tech:</strong> {project.data.tech.join(" · ")}
              </p>
            ) : null
          }
        </div>
      </aside>
    </div>
  </article>

  <style>
    /* layout */
    .page {
      padding: 26px 16px 48px;
      max-width: var(--content, 1100px);
      margin-left: auto;
      margin-right: auto;
    }
    .back a {
      color: rgb(var(--muted));
      text-decoration: none;
    }
    .back a:hover {
      color: rgb(var(--text));
    }

    .head {
      margin-top: 10px;
    }
    h1 {
      margin: 0 0 18px;
      font-size: 44px;
      letter-spacing: -0.03em;
      color: rgb(var(--accent));
      font-weight: 800;
    }
    .lead {
      color: rgb(var(--muted));
      max-width: 80ch;
      margin: 0;
    }

    .metaRow {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 14px;
    }
    .chip {
      border: 1px solid rgb(var(--border));
      background: var(--card-bg);
      border-radius: 999px;
      padding: 7px 10px;
      font-size: 12px;
      color: rgb(var(--muted));
    }
    .chip.featured {
      border-color: rgb(var(--accent) / 0.5);
      color: rgb(var(--text));
    }

    .content {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
      margin-top: 22px;
    }
    @media (min-width: 980px) {
      .content {
        grid-template-columns: 1fr 280px;
        gap: 24px;
      }
      .aside {
        position: sticky;
        top: 18px;
        align-self: start;
      }
    }

    /* typography */
    h2 {
      margin: 18px 0 8px;
      font-size: 18px;
    }
    ul {
      margin: 8px 0 0;
      padding-left: 18px;
      color: rgb(var(--muted));
    }
    li {
      margin: 8px 0;
      line-height: 1.6;
    }

    hr {
      border: 0;
      height: 1px;
      background: rgb(var(--border));
      margin: 18px 0;
    }

    /* aside card */
    .card {
      border: 1px solid rgb(var(--border));
      border-radius: var(--r);
      padding: 14px;
      background: var(--card-bg);
    }
    .card h3 {
      margin: 0 0 10px;
      font-size: 12px;
      font-weight: 600;
      color: rgb(var(--muted));
      letter-spacing: 0.02em;
    }
    .kv {
      margin: 8px 0;
      color: rgb(var(--muted));
      font-size: 13px;
    }
    .kv strong {
      color: rgb(var(--text));
    }

    .projectNav {
      margin-top: 26px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .projectNavLink {
      min-height: 48px;
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      padding: 12px 14px;
      text-decoration: none;
      color: rgb(var(--text));
      border: 1px solid rgb(var(--border));
      border-radius: var(--r);
      background: var(--card-bg);
    }

    .projectNavLink.next {
      justify-content: flex-end;
      text-align: right;
    }

    .projectNavLabel {
      display: block;
      margin-bottom: 3px;
      color: rgb(var(--muted));
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.03em;
    }

    .projectNavLink:hover {
      border-color: rgb(var(--accent));
    }

    @media (max-width: 640px) {
      .projectNav {
        grid-template-columns: 1fr;
      }
    }
  </style>
</SiteLayout>
