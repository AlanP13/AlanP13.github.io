---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const allTimeline = await getCollection("timeline");
const education = allTimeline
  .filter((e) => e.data.kind === "education")
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const workEntries = allTimeline
  .filter((e) => e.data.kind === "work")
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const papers = await getCollection("research");
const papersSorted = [...papers].sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));
const publishedPapers = papersSorted.filter(
  (p) => (p.data.publication_status ?? p.data.status) === "published"
);
const technicalReports = papersSorted.filter(
  (p) => (p.data.publication_status ?? p.data.status) !== "published"
);

const allCerts = await getCollection("certifications");
const certsFeatured = allCerts
  .filter((c) => c.data.featured)
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));
---

<SiteLayout
  title="Academic CV — Alan Palayil"
  description="Academic CV for Alan Palayil — PhD candidate in Information Technology, M.S. Cybersecurity Engineering (IIT 2023), researcher in AI governance, enterprise data, and intelligent automation."
>
  <div class="cv">

    <header class="cvHeader">
      <h1>Alan Palayil</h1>
      <p class="cvTagline">
        PhD Candidate in Information Technology ·
        Application Development Analyst, Genworth Financial
      </p>
      <p class="cvMeta">
        ORCID:
        <a
          href="https://orcid.org/0009-0004-8302-5090"
          target="_blank"
          rel="noopener noreferrer"
          class="cvLink"
        >0009-0004-8302-5090</a>
        <span class="cvMetaSep">·</span>
        <a href="/resume" class="cvLink">Industry Resume →</a>
      </p>
    </header>

    <!-- Education -->
    <section class="cvSection">
      <h2 class="cvSectionTitle">Education</h2>
      {education.map((entry) => (
        <div class="cvEntry">
          <div class="cvEntryMain">
            <span class="cvEntryRole">{entry.data.title}</span>
            <span class="cvEntryOrg">
              {entry.data.orgUrl
                ? <a href={entry.data.orgUrl} target="_blank" rel="noopener noreferrer" class="cvLink">{entry.data.org}</a>
                : entry.data.org}
              {entry.data.location && <span class="cvEntryLoc"> · {entry.data.location}</span>}
            </span>
            {entry.data.subtitle && (
              <span class="cvEntrySub">{entry.data.subtitle}</span>
            )}
          </div>
          <span class="cvEntryDate">{entry.data.dates}</span>
        </div>
      ))}
    </section>

    <!-- Publications -->
    <section class="cvSection">
      <h2 class="cvSectionTitle">Publications</h2>
      {publishedPapers.map((paper) => (
        <div class="cvPaper">
          <div class="cvPaperHeader">
            <span class="cvBadge">Published</span>
            {paper.data.venue && (
              <span class="cvPaperTerm">{paper.data.venue}</span>
            )}
            {paper.data.publication_date && (
              <span class="cvPaperTerm">{paper.data.publication_date.slice(0, 4)}</span>
            )}
          </div>
          <p class="cvPaperTitle">{paper.data.title}</p>
          {paper.data.doi && (
            <p class="cvDoi">
              <a href={`https://doi.org/${paper.data.doi}`} target="_blank" rel="noopener noreferrer" class="cvLink">
                DOI: {paper.data.doi}
              </a>
            </p>
          )}
          {paper.data.citation && (
            <p class="cvCitation">{paper.data.citation}</p>
          )}
          {paper.data.links.length > 0 && (
            <div class="cvPaperLinks">
              {paper.data.links.map((link) => (
                <a href={link.url} class="cvPaperLink" target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </section>

    {technicalReports.length > 0 && (
      <section class="cvSection">
        <h2 class="cvSectionTitle">Technical Reports</h2>
        {technicalReports.map((paper) => (
          <div class="cvPaper">
            <div class="cvPaperHeader">
              {paper.data.publication_type && (
                <span class="cvBadge">{paper.data.publication_type.replace(/-/g, " ")}</span>
              )}
              {paper.data.semester && (
                <span class="cvPaperTerm">{paper.data.semester}</span>
              )}
              {paper.data.university && (
                <span class="cvPaperTerm">{paper.data.university}</span>
              )}
            </div>
            <p class="cvPaperTitle">{paper.data.title}</p>
            {paper.data.citation && (
              <p class="cvCitation">{paper.data.citation}</p>
            )}
            {paper.data.links.length > 0 && (
              <div class="cvPaperLinks">
                {paper.data.links.map((link) => (
                  <a href={link.url} class="cvPaperLink" target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </section>
    )}

    <!-- Academic Honors -->
    <section class="cvSection">
      <h2 class="cvSectionTitle">Academic Honors</h2>
      <div class="cvEntry">
        <div class="cvEntryMain">
          <span class="cvEntryRole">Dean's List</span>
          <span class="cvEntryOrg">Illinois Institute of Technology · B.S. & M.S.</span>
        </div>
        <span class="cvEntryDate">2021-2023</span>
      </div>
    </section>

    <!-- Memberships & Leadership -->
    <section class="cvSection">
      <h2 class="cvSectionTitle">Professional Memberships & Leadership</h2>
      <div class="cvEntry">
        <div class="cvEntryMain">
          <span class="cvEntryRole">Internal Secretary</span>
          <span class="cvEntryOrg">Eta Kappa Nu (IEEE-HKN) · Illinois Institute of Technology</span>
        </div>
        <span class="cvEntryDate">Jan 2022 – May 2023</span>
      </div>
      <div class="cvEntry">
        <div class="cvEntryMain">
          <span class="cvEntryRole">Member</span>
          <span class="cvEntryOrg">Eta Kappa Nu (IEEE-HKN) · Illinois Institute of Technology</span>
        </div>
        <span class="cvEntryDate">2021–2023</span>
      </div>
      <div class="cvEntry">
        <div class="cvEntryMain">
          <span class="cvEntryRole">Member</span>
          <span class="cvEntryOrg">IEEE</span>
        </div>
        <span class="cvEntryDate">May 2024 – Present</span>
      </div>
    </section>

    <!-- Professional Experience (abbreviated) -->
    <section class="cvSection">
      <h2 class="cvSectionTitle">Professional Experience</h2>
      <p class="cvNote">Abbreviated. <a href="/resume" class="cvLink">Full resume →</a></p>
      {workEntries.map((entry) => (
        <div class="cvEntry">
          <div class="cvEntryMain">
            <span class="cvEntryRole">{entry.data.title}</span>
            <span class="cvEntryOrg">{entry.data.org}</span>
          </div>
          <span class="cvEntryDate">{entry.data.dates}</span>
        </div>
      ))}
    </section>

    <!-- Certifications -->
    <section class="cvSection">
      <h2 class="cvSectionTitle">Certifications</h2>
      <p class="cvNote">Selected. <a href="/resume#certifications" class="cvLink">All certifications →</a></p>
      {certsFeatured.slice(0, 5).map((cert) => (
        <div class="cvEntry">
          <div class="cvEntryMain">
            <span class="cvEntryRole">{cert.data.title}</span>
            <span class="cvEntryOrg">{cert.data.issuer}</span>
          </div>
          <span class="cvEntryDate">
            {cert.data.status === "in-progress" ? "In Progress" : (cert.data.dateObtained ?? "Earned")}
          </span>
        </div>
      ))}
    </section>

    <!--
      Future sections — add when content exists:

      Publications (peer-reviewed):
        Use research collection with publication_type "journal-article" | "conference-paper"
        Filter: paper.data.publication_status === "published"

      Speaking & Presentations:
        See 2C-006 in website-roadmap.md — trigger when 1–2 events exist.
        Add a new `speaking` collection or hardcode entries here.

      Peer Review & Service:
        Add when referee work or editorial roles begin.
    -->

  </div>

  <style>
    .cv {
      max-width: 820px;
      margin: 0 auto;
      padding: 44px 0 64px;
    }

    .cvHeader {
      margin-bottom: 40px;
      padding-bottom: 24px;
      border-bottom: 2px solid rgb(var(--accent));
    }
    .cvHeader h1 {
      font-size: 36px;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: rgb(var(--text));
      margin: 0 0 6px;
    }
    .cvTagline {
      font-size: 15px;
      color: rgb(var(--muted));
      margin: 0 0 8px;
    }
    .cvMeta {
      font-size: 13px;
      color: rgb(var(--muted));
      margin: 0;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .cvMetaSep {
      opacity: 0.5;
    }

    .cvSection {
      margin-bottom: 36px;
    }
    .cvSectionTitle {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgb(var(--accent));
      margin: 0 0 16px;
      padding-bottom: 6px;
      border-bottom: 1px solid rgb(var(--border));
    }

    .cvEntry {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      padding: 9px 0;
      border-bottom: 1px solid rgb(var(--border) / 0.5);
    }
    .cvEntry:last-child {
      border-bottom: none;
    }
    .cvEntryMain {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .cvEntryRole {
      font-size: 14px;
      font-weight: 650;
      color: rgb(var(--text));
    }
    .cvEntryOrg {
      font-size: 13px;
      color: rgb(var(--muted));
    }
    .cvEntryLoc {
      font-size: 13px;
      color: rgb(var(--muted));
    }
    .cvEntrySub {
      font-size: 12px;
      color: rgb(var(--muted));
      margin-top: 2px;
      opacity: 0.8;
    }
    .cvEntryDate {
      font-size: 12px;
      color: rgb(var(--muted));
      white-space: nowrap;
      flex-shrink: 0;
      padding-top: 2px;
    }

    .cvPaper {
      padding: 14px 0;
      border-bottom: 1px solid rgb(var(--border) / 0.5);
    }
    .cvPaper:last-child {
      border-bottom: none;
    }
    .cvPaperHeader {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
      flex-wrap: wrap;
    }
    .cvBadge {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgb(var(--accent));
      background: rgb(var(--accent) / 0.1);
      border: 1px solid rgb(var(--accent) / 0.2);
      border-radius: 4px;
      padding: 2px 7px;
    }
    .cvPaperTerm {
      font-size: 12px;
      color: rgb(var(--muted));
    }
    .cvPaperTitle {
      font-size: 14px;
      font-weight: 650;
      color: rgb(var(--text));
      margin: 0 0 4px;
      line-height: 1.4;
    }
    .cvDoi {
      font-size: 12px;
      font-weight: 600;
      margin: 0 0 4px;
    }
    .cvCitation {
      font-size: 12px;
      color: rgb(var(--muted));
      margin: 0 0 6px;
      font-style: italic;
      line-height: 1.5;
    }
    .cvPaperLinks {
      display: flex;
      gap: 10px;
    }
    .cvPaperLink {
      font-size: 12px;
      color: rgb(var(--accent));
      text-decoration: none;
      border: 1px solid rgb(var(--accent) / 0.3);
      border-radius: 4px;
      padding: 2px 8px;
    }
    .cvPaperLink:hover {
      background: rgb(var(--accent) / 0.08);
    }

    .cvNote {
      font-size: 13px;
      color: rgb(var(--muted));
      margin: 0 0 12px;
    }

    .cvLink {
      color: rgb(var(--accent));
      text-decoration: none;
    }
    .cvLink:hover {
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      .cv {
        padding: 32px 0 48px;
      }
      .cvEntry {
        flex-direction: column;
        gap: 4px;
      }
      .cvEntryDate {
        padding-top: 0;
      }
    }
  </style>
</SiteLayout>
