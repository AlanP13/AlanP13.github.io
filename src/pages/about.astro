---
import SiteLayout from "../layouts/SiteLayout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import { FileText, LinkedinLogo, GithubLogo, Envelope, GraduationCap } from "@phosphor-icons/react";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// Auto-import ALL images in src/assets/places
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/places/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const placeImagesRaw = Object.entries(modules)
  .map(([filePath, mod]) => {
    const file = filePath.split("/").pop() ?? "";
    const name = decodeURIComponent(file)
      .replace(/\.[^.]+$/, "")
      .replace(/[-_]+/g, " ")
      .trim();
    return { image: mod.default, name };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

// Optimize at build time: resize to gallery display width, convert to WebP
const placeImages = await Promise.all(
  placeImagesRaw.map(async ({ image, name }) => {
    const opt = await getImage({ src: image, width: 1000, format: "webp" });
    return { src: opt.src, name };
  })
);

// Auto-import Carousel images (Alan photos)
const carouselModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/about/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const carouselImagesRaw = Object.entries(carouselModules)
  .map(([filePath, mod]) => ({ file: filePath.split("/").pop() ?? "", image: mod.default }))
  .sort((a, b) => a.file.localeCompare(b.file));

// Optimize at build time: 2× the 320px carousel max-width, convert to WebP
const carouselImages = await Promise.all(
  carouselImagesRaw.map(async ({ image }) => {
    const opt = await getImage({ src: image, width: 640, format: "webp" });
    return opt.src;
  })
);
---

<SiteLayout
  title="About — Alan Palayil"
  description="About Alan Palayil — Data Engineer at Genworth Financial, Ph.D. student in AI and Data Science, building financial data infrastructure."
>
  <section class="about">
    <h1>About Me</h1>

    <div class="heroGrid">
      <div class="left">
        <p>
          Hey! I’m
          <a
            href="https://www.instagram.com/alan.palayil/"
            target="_blank"
            rel="noopener noreferrer"
            class="dotted-link">Alan Palayil</a
          >, a <strong>Data Engineer at Genworth Financial</strong>,
          working at the intersection of <strong>enterprise data platforms</strong>,
          <strong>financial systems</strong>, and <strong>AI governance</strong>. My work focuses on modernizing investment accounting workflows by
          building scalable, production-grade pipelines that prioritize
          <strong>accuracy</strong>, <strong>auditability</strong>, and
          <strong>long-term maintainability</strong>.
        </p>

        <p>
          I currently work at
          <a
            href="https://www.genworth.com"
            target="_blank"
            rel="noopener noreferrer"
            class="dotted-link">Genworth Financial</a
          >, where I own and support critical accounting platforms across
          <strong>Fixed Income</strong>, <strong>Derivatives</strong>, and
          <strong>Commercial Mortgage Loans</strong>, collaborating closely with
          Accounting, Operations, and Infrastructure teams to deliver systems
          that are both technically robust and business-critical.
        </p>

        <p>
          Alongside my professional work, I’m pursuing a
          <a
            href="https://www.ucumberlands.edu/academics/graduate/phd-information-technology"
            target="_blank"
            rel="noopener noreferrer"
            class="dotted-link">PhD in Information Technology</a
          >
          with a focus on <strong>AI</strong> and <strong>Data Science</strong>,
          centered on applying intelligent, data-driven techniques to enterprise
          systems and automation.
        </p>

        <p>
          Outside of work, I enjoy <strong>Painting</strong>,
          <strong>Digital Art</strong>, <strong>3D Printing</strong>,
          <strong>Gaming</strong>, and building
          <a href="/projects" class="dotted-link">Creative Projects</a>
          that blend engineering with design.
        </p>

        <div class="socialRow" aria-label="Social links">
          <a class="social" href="/resume">
            <span class="icon" aria-hidden="true">
              <FileText size={18} />
            </span>
            Resume
          </a>
          <span class="sep" aria-hidden="true">|</span>

          <a class="social" href="/cv">
            <span class="icon" aria-hidden="true">
              <GraduationCap size={18} />
            </span>
            CV
          </a>
          <span class="sep" aria-hidden="true">|</span>

          <a class="social" href="https://www.linkedin.com/in/alan-palayil/" target="_blank" rel="noopener noreferrer">
            <span class="icon" aria-hidden="true">
              <LinkedinLogo size={18} />
            </span>
            LinkedIn
          </a>
          <span class="sep" aria-hidden="true">|</span>

          <a class="social" href="https://github.com/AlanP13" target="_blank" rel="noopener noreferrer">
            <span class="icon" aria-hidden="true">
              <GithubLogo size={18} />
            </span>
            GitHub
          </a>
          <span class="sep" aria-hidden="true">|</span>

          <a class="social" href="mailto:alanpalayil+portfolio@gmail.com" target="_blank" rel="noopener noreferrer">
            <span class="icon" aria-hidden="true">
              <Envelope size={18} />
            </span>
            Email
          </a>
        </div>
      </div>

      <div class="right">
        <ImageCarousel images={carouselImages} />
      </div>
    </div>
  </section>

  <section class="service">
    <h2 class="serviceTitle">Leadership & Service</h2>
    <ul class="serviceList">
      <li class="serviceItem">
        <div class="svcInfo">
          <span class="svcRole">Member</span>
          <span class="svcOrg">IEEE</span>
        </div>
        <span class="svcYear">May 2024 – Present</span>
      </li>
      <li class="serviceItem">
        <div class="svcInfo">
          <span class="svcRole">Internal Secretary</span>
          <span class="svcOrg">Eta Kappa Nu (IEEE-HKN) · Illinois Institute of Technology</span>
        </div>
        <span class="svcYear">Apr 2022 – May 2023</span>
      </li>
      <li class="serviceItem">
        <div class="svcInfo">
          <span class="svcRole">Dean's List</span>
          <span class="svcOrg">Illinois Institute of Technology · B.S. & M.S.</span>
        </div>
        <span class="svcYear">2021–2023</span>
      </li>
    </ul>
  </section>

  <section class="gallery">
    <div class="galleryHeader">
      <h2 class="galleryTitle">Travel</h2>
      <button id="galleryPauseBtn" class="galleryPause">Pause</button>
    </div>

    <div class="grid" id="placesGallery" data-rotating>
      {
        placeImages.slice(0, 3).map((img) => (
          <div class="imgCard">
            <img src={img.src} alt={img.name} loading="lazy" width="800" height="220" />
            <div class="imgLabel">{img.name}</div>
          </div>
        ))
      }
    </div>

    <p class="muted">
      Images Presented: <strong>{placeImages.length}</strong>
    </p>

    <script define:vars={{ placeImages }}>
      const VISIBLE = 3;
      const INTERVAL = 5000;
      const FADE_MS = 150;

      let index = 0;
      let timer = null;
      let hoverPaused = false;
      let focusPaused = false;
      let userPaused = false;

      const isPaused = () => hoverPaused || focusPaused || userPaused;

      const container = document.getElementById("placesGallery");
      const pauseBtn = document.getElementById("galleryPauseBtn");
      const cards = Array.from(container.querySelectorAll(".imgCard"));
      const count = Math.min(VISIBLE, cards.length);

      // Kick off all image fetches immediately so they're cached before first rotation
      placeImages.forEach(({ src }) => { const p = new Image(); p.src = src; });

      function setCard(card, img) {
        const imageEl = card.querySelector("img");
        const labelEl = card.querySelector(".imgLabel");

        card.classList.add("is-fading");

        const preload = new Image();
        const doSwap = () => {
          imageEl.src = img.src;
          imageEl.alt = img.name;
          labelEl.textContent = img.name;
          card.classList.remove("is-fading");
        };

        preload.src = img.src;
        if (preload.complete) {
          setTimeout(doSwap, FADE_MS);
        } else {
          const deadline = Date.now() + FADE_MS;
          const onReady = () => setTimeout(doSwap, Math.max(0, deadline - Date.now()));
          preload.onload = onReady;
          preload.onerror = onReady;
        }
      }

      function render() {
        if (!placeImages?.length) return;
        for (let i = 0; i < count; i++) {
          setCard(cards[i], placeImages[(index + i) % placeImages.length]);
        }
      }

      function tick() {
        if (!placeImages?.length) return;
        index = (index + count) % placeImages.length;
        render();
      }

      function syncBtn() {
        if (!pauseBtn) return;
        pauseBtn.textContent = userPaused ? "Play" : "Pause";
        pauseBtn.setAttribute("aria-label", userPaused ? "Resume gallery rotation" : "Pause gallery rotation");
      }

      container.addEventListener("mouseenter", () => { hoverPaused = true; });
      container.addEventListener("mouseleave", () => { hoverPaused = false; });
      container.addEventListener("focusin",    () => { focusPaused = true; });
      container.addEventListener("focusout",   () => { focusPaused = false; });

      pauseBtn?.addEventListener("click", () => {
        userPaused = !userPaused;
        syncBtn();
      });

      // Do not start auto-rotation when the user prefers reduced motion
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (reducedMotion.matches) {
        if (pauseBtn) pauseBtn.hidden = true;
      } else {
        // HTML already shows the correct first frame — just start the rotation
        timer = setInterval(() => { if (!isPaused()) tick(); }, INTERVAL);
      }
    </script>
  </section>

  <style>
    .about {
      padding-top: 44px;
      padding-bottom: 24px;
      /* ✅ match section width */
      max-width: var(--content, 1100px);
      margin-left: auto;
      margin-right: auto;
    }

    h1 {
      margin: 0 0 18px;
      font-size: 44px;
      letter-spacing: -0.03em;
      color: rgb(var(--accent));
      font-weight: 800;
    }
    p strong {
      color: rgb(var(--text));
      font-weight: 650;
    }
    .muted {
      color: rgb(var(--muted));
    }
    .dotted-link {
      font-weight: 700;
      color: rgb(var(--accent));
      text-decoration: underline dotted;
      text-underline-offset: 6px;
    }
    .dotted-link:hover {
      text-decoration: underline solid;
    }

    .socialRow {
      margin-top: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      color: rgb(var(--muted));
      font-size: 14px;
    }
    .social {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: rgb(var(--muted));
      opacity: 0.95;
    }
    .social:hover {
      color: rgb(var(--accent));
    }
    .icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border: 1px solid rgb(var(--border));
      border-radius: 10px;
      background: var(--card-bg);
      color: rgb(var(--accent));
    }
    .sep {
      color: rgb(var(--muted));
      opacity: 0.7;
      margin: 0 8px;
    }

    .heroGrid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }
    @media (min-width: 980px) {
      .heroGrid {
        grid-template-columns: 4fr 2fr;
        gap: 44px;
      }
    }
    .right {
      display: none;
    }
    @media (min-width: 980px) {
      .right {
        display: flex;
        justify-content: flex-end;
        align-items: flex-start;
        width: 100%;
      }
    }

    .gallery {
      margin-top: 26px;
      padding-top: 12px;
      max-width: var(--content, 1100px);
      margin-left: auto;
      margin-right: auto;
    }
    .galleryHeader {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }
    .galleryTitle {
      margin: 0;
      font-size: 16px;
      letter-spacing: -0.01em;
      font-weight: 700;
    }
    .galleryPause {
      padding: 3px 10px;
      border-radius: var(--r);
      border: 1px solid rgb(var(--border));
      background: var(--card-bg);
      color: rgb(var(--muted));
      font-size: 12px;
      cursor: pointer;
      transition: color 120ms ease, border-color 120ms ease;
    }
    .galleryPause:hover {
      color: rgb(var(--text));
      border-color: rgb(var(--accent));
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    @media (min-width: 760px) {
      .grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .imgCard {
      border: 1px solid rgb(var(--border));
      border-radius: var(--r);
      overflow: hidden;
      background: var(--card-bg);
      position: relative;
      transition:
        transform 120ms ease,
        border-color 120ms ease;
    }
    .imgCard:hover {
      transform: translateY(-2px);
      border-color: rgb(var(--accent));
    }

    .imgCard img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
      transition:
        opacity 450ms ease,
        transform 450ms ease;
      will-change: opacity, transform;
    }

    .imgLabel {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 10px 12px 10px 20px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: rgb(255, 255, 255);
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.65),
        rgba(0, 0, 0, 0.15),
        transparent
      );
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }

    .imgLabel::before {
      content: "";
      position: absolute;
      left: 8px;
      top: 10px;
      bottom: 10px;
      width: 3px;
      border-radius: 999px;
      background: rgb(var(--accent));
      opacity: 0.9;
    }

    .imgCard:hover .imgLabel {
      opacity: 1;
      transform: translateY(0);
    }

    .imgCard.is-fading img,
    .imgCard.is-fading .imgLabel {
      opacity: 0;
      transform: translateY(2px);
    }

    @media (hover: none) {
      .imgLabel {
        opacity: 1;
        transform: none;
      }
    }

    .service {
      max-width: var(--content, 1100px);
      margin: 0 auto 32px;
    }
    .serviceTitle {
      margin: 0 0 14px;
      font-size: 16px;
      letter-spacing: -0.01em;
      color: rgb(var(--accent));
      font-weight: 700;
    }
    .serviceList {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .serviceItem {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 0;
      border-bottom: 1px solid rgb(var(--border));
    }
    .serviceItem:first-child {
      border-top: 1px solid rgb(var(--border));
    }
    .svcInfo {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .svcRole {
      font-size: 14px;
      font-weight: 650;
      color: rgb(var(--text));
    }
    .svcOrg {
      font-size: 13px;
      color: rgb(var(--muted));
    }
    .svcYear {
      font-size: 13px;
      color: rgb(var(--muted));
      white-space: nowrap;
      flex-shrink: 0;
    }
  </style>
</SiteLayout>
