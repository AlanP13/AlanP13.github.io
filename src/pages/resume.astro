      <div class="rEntry">
        <div class="rEntryHead">
          <div class="rLeft">
            <span class="rTitle">B.S. Computer &amp; Cybersecurity Engineering</span>
            <span class="rOrg"><a href="https://www.iit.edu/academics/programs/computer-and-cybersecurity-engineering-bs" target="_blank" rel="noopener noreferrer">Illinois Institute of Technology</a></span>
          </div>
          <div class="rRight">
            <span class="rDates">August 2019 – August 2023</span>
