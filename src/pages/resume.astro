    {certsSorted.length > 0 && (
      <section class="rSection" id="certifications">
        <h2 class="rHead">Certifications</h2>
        {certsSorted.map((cert) => (
          <div class="rEntry">
            <div class="rEntryHead">
              <div class="rLeft">
                <span class="rTitle">{cert.data.title}</span>
                <span class="rOrg">
                  {cert.data.issuerUrl
                    ? <a href={cert.data.issuerUrl} target="_blank" rel="noopener noreferrer">{cert.data.issuer}</a>
                    : cert.data.issuer}
                </span>
              </div>
              <div class="rRight">
                {cert.data.status === "in-progress"
                  ? <span class="rDates rInProgress">In Progress</span>
