  <style>
    .resume-wrap {
      max-width: var(--content, 1100px);
      margin: 0 auto;
      padding-top: 44px;
      padding-bottom: 60px;
    }

    .pageHead {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 28px;
      gap: 16px;
      flex-wrap: wrap;
    }
    h1 {
      margin: 0;
      font-size: 44px;
      letter-spacing: -0.03em;
      color: rgb(var(--accent));
      font-weight: 800;
    }
    .dlBtn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 10px;
      border: 1px solid rgb(var(--accent));
      background: color-mix(in srgb, rgb(var(--accent)) 10%, transparent);
      color: rgb(var(--accent));
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: background 150ms ease, box-shadow 150ms ease;
      white-space: nowrap;
    }
    .dlBtn:hover {
      background: color-mix(in srgb, rgb(var(--accent)) 18%, transparent);
      box-shadow: 0 4px 16px color-mix(in srgb, rgb(var(--accent)) 22%, transparent);
    }

    .contactBlock {
      border: 1px solid rgb(var(--border));
      border-radius: 14px;
      padding: 20px 24px;
      background: var(--card-bg);
      margin-bottom: 32px;
    }
    .contactName {
      font-size: 22px;
      font-weight: 700;
      color: rgb(var(--text));
      margin-bottom: 2px;
    }
    .contactRole {
      font-size: 14px;
      color: rgb(var(--accent));
      font-weight: 500;
      margin-bottom: 10px;
    }
    .contactLinks {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 0;
      font-size: 13px;
      color: rgb(var(--muted));
      align-items: center;
    }
    .contactLinks a {
      color: rgb(var(--muted));
      text-decoration: none;
    }
    .contactLinks a:hover { color: rgb(var(--accent)); }
    .cdot { margin: 0 8px; opacity: 0.4; }

    .rSection { margin-bottom: 36px; }
    .rHead {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: rgb(var(--accent));
      margin: 0 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgb(var(--border));
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .rHead::before {
      content: "";
      display: inline-block;
      width: 3px;
      height: 14px;
      border-radius: 999px;
      background: rgb(var(--accent));
      opacity: 0.8;
      flex-shrink: 0;
    }

    .rEntry {
      margin-bottom: 24px;
      padding-bottom: 24px;
      border-bottom: 1px solid color-mix(in srgb, rgb(var(--border)) 50%, transparent);
    }
    .rEntry:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

    .rEntryHead {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 6px;
      flex-wrap: wrap;
    }
    .rLeft { display: flex; flex-direction: column; gap: 2px; }
    .rRight { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex-shrink: 0; }

    .rTitle { font-size: 15.5px; font-weight: 700; color: rgb(var(--text)); }
    .rOrg a { font-size: 13.5px; font-weight: 500; color: rgb(var(--accent)); text-decoration: none; }
    .rOrg a:hover { text-decoration: underline; }
    .rDates { font-size: 13px; color: rgb(var(--muted)); white-space: nowrap; }
    .rInProgress { color: rgb(var(--accent)); font-weight: 600; }
    .rLoc { font-size: 12px; color: rgb(var(--muted)); opacity: 0.7; white-space: nowrap; }

    .rSub { font-size: 13px; color: rgb(var(--muted)); margin: 0 0 8px; line-height: 1.55; font-style: italic; }
    .rBullets { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 5px; }
    .rBullets li { font-size: 13.5px; color: color-mix(in srgb, rgb(var(--text)) 85%, transparent); line-height: 1.6; }

    .skillsGrid { display: flex; flex-direction: column; gap: 10px; }
    .skillRow {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 12px;
      align-items: start;
    }
    .skillLabel {
      font-size: 12px;
      font-weight: 600;
      color: rgb(var(--muted));
      padding-top: 4px;
    }
    .skillTags { display: flex; flex-wrap: wrap; gap: 6px; }
    .skillTags span {
      font-size: 12.5px;
      padding: 3px 10px;
      border-radius: 999px;
      border: 1px solid rgb(var(--border));
      background: color-mix(in srgb, rgb(var(--card)) 80%, transparent);
      color: rgb(var(--text));
      opacity: 0.88;
    }
    .rCredLink {
      font-size: 12px;
      color: rgb(var(--accent));
      text-decoration: none;
    }
    .rCredLink:hover { text-decoration: underline; }
    .rCertSkills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .rCertSkills span {
      font-size: 12px;
      padding: 2px 9px;
      border-radius: 999px;
      border: 1px solid rgb(var(--border));
      color: rgb(var(--muted));
      background: var(--card-bg);
    }

    @media (max-width: 760px) {
      h1 { font-size: 36px; }
      .skillRow { grid-template-columns: 120px 1fr; }
    }
    @media (max-width: 640px) {
      h1 { font-size: 32px; }
      .pageHead { flex-direction: column; align-items: flex-start; }
      .rEntryHead { flex-direction: column; gap: 4px; }
      .rRight { align-items: flex-start; }
      .contactBlock { padding: 16px; }
      .skillRow { grid-template-columns: 1fr; gap: 6px; }
    }
  </style>
</SiteLayout>