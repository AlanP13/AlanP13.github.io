---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { DownloadSimple } from "@phosphor-icons/react";

const certItems = await getCollection("certifications");
const certsSorted = [...certItems].filter((c) => c.data.featured).sort((a, b) => {
  const priority: Record<string, number> = { "in-progress": 0, "planned": 1, "earned": 2, "expired": 3 };
  const sa = priority[a.data.status] ?? 99;
  const sb = priority[b.data.status] ?? 99;
  if (sa !== sb) return sa - sb;
  return (b.data.order ?? 0) - (a.data.order ?? 0);
});
---

<SiteLayout
  title="Resume — Alan Palayil"
  description="Resume of Alan Palayil — Data Engineer at Genworth Financial, specializing in enterprise data pipelines, financial systems, and AI Governance research."
