        <div class="rEntryHead">
          <div class="rLeft">
            <span class="rTitle">Associate Application Development Analyst</span>
            <span class="rOrg"><a href="https://www.genworth.com" target="_blank" rel="noopener noreferrer">Genworth Financial</a></span>
          </div>
          <div class="rRight">
            <span class="rDates">July 2023 - December 2025</span>
            <span class="rLoc">Richmond, VA · Hybrid</span>
          </div>
        </div>
